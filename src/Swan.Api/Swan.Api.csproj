<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Swan.Adapters.WordPress\Swan.Adapters.WordPress.csproj" />
    <ProjectReference Include="..\Swan.Adapters.Abstractions\Swan.Adapters.Abstractions.csproj" />
    <ProjectReference Include="..\Swan.Infrastructure\Swan.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Optional: build the Angular client and copy it into wwwroot as part of publish, producing one deployable.
      dotnet publish src/Swan.Api -c Release -p:BuildClientApp=true
    Requires Node/npm. The CI workflow builds the client and populates wwwroot itself, so this stays opt-in.
  -->
  <Target Name="BuildClientApp" BeforeTargets="ComputeFilesToPublish" Condition="'$(BuildClientApp)' == 'true'">
    <PropertyGroup>
      <ClientDir>$(MSBuildProjectDirectory)/../web/Swan.Web</ClientDir>
    </PropertyGroup>
    <Exec Command="npm ci" WorkingDirectory="$(ClientDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientDir)" />
    <ItemGroup>
      <ClientFiles Include="$(ClientDir)/dist/swan-web/browser/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ClientFiles)" DestinationFolder="$(MSBuildProjectDirectory)/wwwroot/%(RecursiveDir)" />
  </Target>
</Project>

