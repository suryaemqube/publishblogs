{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Sites": [
    {
      "Id": "emqube",
      "Name": "emqube.com (headless WP + Gatsby)",
      "RestOrigin": "https://wp.emqube.com",
      "PostTypeKey": "blogs",
      "RestBase": "blogs",
      "CredentialsFile": "%USERPROFILE%\\.swan-secrets\\creds.txt",
      "WriteYoastMeta": true
    }
  ]
}
